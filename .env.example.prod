# ============================================================
# Arthakarya — PRODUCTION environment
# ============================================================
# Salin file ini menjadi `.env` di server, lalu isi semua nilai.
# Nilai secret acak dibuat dengan: bash scripts/gen-secrets.sh
#
# ⚠️  FILE .env TIDAK BOLEH DI-COMMIT KE GIT. Simpan hanya di server.

# ===== Database =====
POSTGRES_USER=arthakarya
POSTGRES_PASSWORD=GANTI_SECRET_ACAK
POSTGRES_DB=arthakarya

# ===== Backend =====
# JWT secret acak (mis. `openssl rand -base64 48`)
JWT_SECRET=GANTI_SECRET_ACAK_PANJANG
# Origin browser yang diizinkan (hostname internal + localhost untuk dev).
# Pisahkan dengan koma jika lebih dari satu.
CORS_ORIGIN=https://arthakarya.dinas.go.id

# ===== Hostname & TLS =====
# Hostname internal tempat aplikasi diakses (di bawah domain terdaftar,
# subdomainnya didelegasikan ke Cloudflare).
SERVER_NAME=arthakarya.dinas.go.id
# Email untuk Let's Encrypt (notifikasi kadaluarsa sertifikat)
LETSENCRYPT_EMAIL=admin@dinas.go.id

# ===== Seed admin awal (opsional, default: admin) =====
ADMIN_USERNAME=admin

# ===== Proxy jaringan (wajib jika internet instansi lewat proxy) =====
# Isi jika jaringan kantor mewajibkan proxy untuk akses internet
# (dipakai saat build image & service certbot).
# HTTP_PROXY=http://proxy.kantor.go.id:8080
# HTTPS_PROXY=http://proxy.kantor.go.id:8080
# NO_PROXY=localhost,127.0.0.1,arthakarya_db

# ===== Backup & monitoring (dibaca oleh scripts/backup.sh & nightly-check.sh) =====
BACKUP_DIR=/var/backups/arthakarya
NAS_HOST=nas.kantor.local
NAS_USER=backup
NAS_PATH=/backups/arthakarya
# Token & chat id bot Telegram untuk notifikasi status (kosongkan jika belum ada)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
